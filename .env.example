# Copy this file to .env and fill in the values. Never commit .env.

# NASA FIRMS map key for the near-real-time API (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=

# Copernicus Climate Data Store credentials, read by cdsapi.
# Alternative: put them in ~/.cdsapirc instead of here.
# TODO(verify): confirm the current CDS API URL and key format at https://cds.climate.copernicus.eu/how-to-api
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=
